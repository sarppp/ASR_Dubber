# Keep the batch runner under version control despite the parent allowlist.
!.gitignore
!batch_subtitles.py
!local_subtitles.py
!local-asr-requirements.txt
!BATCH_SUBTITLES.md
!test_local_subtitles.py
!organize_subtitles.py
!modal-control
!modal_control/
!modal_control/**
!batch_dubbing/
!batch_dubbing/*.py
# Keep the investigation code and frozen test fixture, not generated evidence/media.
!dubbing_naturalness_2026-10-28/
dubbing_naturalness_2026-10-28/*
!dubbing_naturalness_2026-10-28/*.py
!dubbing_naturalness_2026-10-28/review_template.html
!dubbing_naturalness_2026-10-28/experiment_inputs.json
!dubbing_naturalness_2026-10-28/source_validation_inputs.json
!dubbing_naturalness_2026-10-28/HANDOFF.md
!dubbing_naturalness_2026-10-28/RESEARCH_ISOCHRONY_2026-10-29.md
!dubbing_naturalness_2026-10-28/cheap_native_inputs.json
!dubbing_naturalness_2026-10-28/cheap_native_batch.json
# Shared worker dependency; all benchmark data and other outputs remain local.
!speech_model_benchmark_2026-10-27/
speech_model_benchmark_2026-10-27/*
!speech_model_benchmark_2026-10-27/code/
speech_model_benchmark_2026-10-27/code/*
!speech_model_benchmark_2026-10-27/code/telemetry.py
modal_control/.state/
modal_control/batch_inputs/
modal_control/**/__pycache__/
# Local inputs and generated outputs remain on disk, outside version control.
modal_control/*_input_manifest.json
modal_control/**/*.log
modal_control/**/*.mp4
modal_control/**/*.wav
modal_control/**/*.srt
